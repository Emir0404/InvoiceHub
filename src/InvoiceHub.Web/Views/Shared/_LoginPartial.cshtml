@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<ul class="navbar-nav align-items-md-center gap-md-2">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item dropdown">
        <button class="nav-link dropdown-toggle account-link" type="button" id="account-menu" data-bs-toggle="dropdown" aria-expanded="false">@User.Identity?.Name</button>
        <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="account-menu">
            <li><a class="dropdown-item" asp-controller="Account" asp-action="Password">Change password</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item">Log out</button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Log in</a></li>
    <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Create account</a></li>
}
</ul>
