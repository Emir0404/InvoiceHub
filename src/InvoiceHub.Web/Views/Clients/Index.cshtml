@model IReadOnlyList<Client>
@{
    ViewData["Title"] = "Clients";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">Clients</h1>
    <a class="btn btn-primary" asp-action="Create">Add client</a>
</div>

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="card-body text-muted">No clients yet. Add the first one to start invoicing.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead><tr><th>Name</th><th>Email</th><th>Tax ID</th><th></th></tr></thead>
                <tbody>
                @foreach (var client in Model)
                {
                    <tr>
                        <td class="fw-medium">@client.Name</td>
                        <td>@client.Email</td>
                        <td>@client.TaxId</td>
                        <td class="num">
                            <a class="btn btn-sm btn-primary" asp-controller="Invoices" asp-action="Create" asp-route-clientId="@client.Id">Invoice</a>
                            <a class="btn btn-sm btn-quiet" asp-action="Edit" asp-route-id="@client.Id">Edit</a>
                            <form class="d-inline" asp-action="Delete" asp-route-id="@client.Id" method="post"
                                  data-confirm="Delete @client.Name? This cannot be undone.">
                                <button class="btn btn-sm btn-quiet-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
