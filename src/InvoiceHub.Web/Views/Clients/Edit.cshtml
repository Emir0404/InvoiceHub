@model ClientForm
@{
    ViewData["Title"] = "Edit client";
}

<h1 class="h3 mb-4">Edit client</h1>

<div class="card" style="max-width: 44rem">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@ViewBag.ClientId" method="post">
            <partial name="_ClientForm" model="Model" />
            <button class="btn btn-primary" type="submit">Save changes</button>
            <a class="btn btn-link" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
