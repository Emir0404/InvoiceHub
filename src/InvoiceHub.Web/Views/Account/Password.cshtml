@model ChangePasswordForm
@{
    ViewData["Title"] = "Change password";
}

<h1 class="h3 mb-1">Change password</h1>
<p class="text-muted mb-4">Signed in as <strong>@User.Identity?.Name</strong>.</p>

<div class="card" style="max-width: 32rem">
    <div class="card-body">
        <form asp-action="Password" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="CurrentPassword" class="form-label"></label>
                <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="password-hint" />
                <div id="password-hint" class="form-text">At least 8 characters, with an upper and a lower case letter, a number and a symbol.</div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" type="submit">Change password</button>
                <a class="btn btn-quiet" asp-controller="Home" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
