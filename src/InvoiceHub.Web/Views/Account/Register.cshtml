@model RegisterForm
@{
    ViewData["Title"] = "Create your account";
}

<div class="auth-card">
    <h1 class="h3 mb-1">Create your account</h1>
    <p class="text-muted mb-4">Free, and ready in a minute.</p>
    <div class="card"><div class="card-body p-4">
        <form asp-action="Register" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="password-hint" />
                <div id="password-hint" class="form-text">At least 8 characters, with an upper and a lower case letter, a number and a symbol.</div>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button class="btn btn-primary w-100" type="submit">Create account</button>
        </form>
    </div></div>
    <p class="text-center text-muted mt-4 mb-2">Already have an account?</p>
    <a class="btn btn-quiet w-100" asp-action="Login">Log in</a>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
